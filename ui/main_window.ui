         <item row="1" column="1"><widget class="QPushButton" name="saveCalibrationButton"><property name="text"><string>Зберегти калібрування</string></property><property name="maximumWidth"><number>200</number></property></widget></item>
         <item row="2" column="0"><widget class="QPushButton" name="calibrateCameraButton"><property name="text"><string>Розрахувати калібрування камери</string></property><property name="maximumWidth"><number>270</number></property></widget></item>
         <item row="2" column="1"><widget class="QPushButton" name="loadCalibrationButton"><property name="text"><string>Завантажити калібрування</string></property><property name="maximumWidth"><number>220</number></property></widget></item>
        </layout>
