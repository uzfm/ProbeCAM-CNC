QGroupBox {
  border: 1px solid #3a3f4b;
  border-radius: 6px;
  margin-top: 14px;
  padding-top: 6px;
  font-weight: 600;
  color: #9fd3ff;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
}
QPushButton {
  background-color: #2c313c;
  border: 1px solid #454b58;
  border-radius: 4px;
  padding: 7px 10px;
  color: #e8e8e8;
}
QPushButton:hover { background-color: #394050; }
QPushButton:pressed { background-color: #1f242c; }
QTabWidget::pane { border: 1px solid #3a3f4b; top: -1px; }
QTabBar::tab {
  background: #23262d;
  padding: 8px 18px;
  border: 1px solid #3a3f4b;
  border-bottom: none;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}
QTabBar::tab:selected { background: #2c313c; color: #9fd3ff; }
QComboBox, QSpinBox {
  background: #20242b;
  border: 1px solid #454b58;
  border-radius: 4px;
  padding: 4px;
  color: #e8e8e8;
}
QPlainTextEdit {
