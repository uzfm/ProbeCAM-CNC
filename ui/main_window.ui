        <item row="2" column="1"><widget class="QCheckBox" name="showContoursCheck"><property name="text"><string>Показувати контури та кут</string></property><property name="checked"><bool>true</bool></property></widget></item>
        <item row="2" column="2"><widget class="QCheckBox" name="mouseRoiCheck"><property name="text"><string>Виділяти ROI мишею</string></property></widget></item>
        <item row="2" column="3"><widget class="QCheckBox" name="mouseLineCheck"><property name="text"><string>Малювати лінію мишею</string></property></widget></item>
        <item row="3" column="0"><widget class="QCheckBox" name="mousePointCheck"><property name="text"><string>Додавати точки мишею</string></property></widget></item>
        <item row="3" column="1"><widget class="QPushButton" name="fitRoiContourButton"><property name="text"><string>Знайти контур у ROI</string></property><property name="maximumWidth"><number>190</number></property></widget></item>
        <item row="3" column="2"><widget class="QPushButton" name="cancelSelectionButton"><property name="text"><string>Скасувати виділення</string></property><property name="maximumWidth"><number>190</number></property></widget></item>
       </layout></item>
