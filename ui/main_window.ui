     <widget class="QWidget" name="calibrationTab">
      <attribute name="title">
       <string>Калібрування</string>
      </attribute>
      <layout class="QVBoxLayout" name="calibrationLayout">
       <item><layout class="QGridLayout" name="calibrationParametersLayout">
        <item row="0" column="0"><widget class="QLabel" name="boardColsLabel"><property name="text"><string>Внутрішні стовпці</string></property></widget></item>
        <item row="0" column="1"><widget class="QSpinBox" name="boardColsSpin"><property name="minimum"><number>2</number></property><property name="maximum"><number>30</number></property><property name="value"><number>9</number></property></widget></item>
        <item row="0" column="2"><widget class="QLabel" name="boardRowsLabel"><property name="text"><string>Внутрішні рядки</string></property></widget></item>
        <item row="0" column="3"><widget class="QSpinBox" name="boardRowsSpin"><property name="minimum"><number>2</number></property><property name="maximum"><number>30</number></property><property name="value"><number>6</number></property></widget></item>
        <item row="1" column="0"><widget class="QLabel" name="squareSizeLabel"><property name="text"><string>Розмір квадрата (мм)</string></property></widget></item>
        <item row="1" column="1"><widget class="QDoubleSpinBox" name="squareSizeSpin"><property name="minimum"><double>0.100000000000000</double></property><property name="maximum"><double>1000.000000000000000</double></property><property name="value"><double>10.000000000000000</double></property></widget></item>
        <item row="1" column="2" colspan="2"><widget class="QLabel" name="calibrationSamplesLabel"><property name="text"><string>Зразків: 0 (мінімум 3)</string></property></widget></item>
        <item row="2" column="0" colspan="2"><widget class="QCheckBox" name="fisheyeCalibrationCheck"><property name="text"><string>Модель калібрування «риб’яче око»</string></property></widget></item>
        <item row="2" column="2" colspan="2"><widget class="QCheckBox" name="applyUndistortCheck"><property name="text"><string>Застосовувати корекцію дисторсії</string></property><property name="checked"><bool>true</bool></property></widget></item>
        <item row="3" column="0"><widget class="QLabel" name="referenceLengthLabel"><property name="text"><string>Реальна довжина лінії (мм)</string></property></widget></item>
        <item row="3" column="1"><widget class="QDoubleSpinBox" name="referenceLengthSpin"><property name="minimum"><double>0.001000000000000</double></property><property name="maximum"><double>100000.000000000000000</double></property><property name="decimals"><number>3</number></property><property name="value"><double>100.000000000000000</double></property></widget></item>
       </layout></item>
       <item>
        <widget class="QLabel" name="calibrationInfoLabel">
         <property name="text">
          <string>Калібрування об’єктива: укажіть параметри шахівниці, захопіть 8–15 зразків у різних положеннях і розрахуйте калібрування камери.
Калібрування масштабу: покладіть лінійку в площині деталі, намалюйте по ній еталонну лінію у вкладці «Технічний зір», введіть її реальну довжину нижче та розрахуйте піксель/мм.
Збережене калібрування автоматично завантажується для вибраної камери.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item><widget class="QLabel" name="calibrationCaptureTitle"><property name="text"><string>Захоплення та розрахунок</string></property><property name="styleSheet"><string notr="true">font-weight:700; color:#8ac8ff;</string></property></widget></item>
       <item>
        <layout class="QGridLayout" name="calibrationToolsLayout">
         <item row="0" column="0"><widget class="QPushButton" name="checkerboardButton"><property name="text"><string>Захопити шахівницю</string></property><property name="maximumWidth"><number>190</number></property></widget></item>
         <item row="0" column="1"><widget class="QPushButton" name="charucoButton"><property name="text"><string>Захопити Charuco</string></property><property name="maximumWidth"><number>170</number></property></widget></item>
